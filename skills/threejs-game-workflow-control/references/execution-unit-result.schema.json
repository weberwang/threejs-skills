{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "threejs-execution-unit-result.schema.json",
  "title": "实施单元完成证据",
  "type": "object",
  "additionalProperties": false,
  "required": ["resultId", "workItemId", "packageId", "unitId", "baselineHash", "codeFingerprint", "diffFingerprint", "completedAt", "commands", "files", "fileHashes", "verdict"],
  "properties": {
    "resultId": {"type": "string", "minLength": 1},
    "workItemId": {"type": "string", "minLength": 1},
    "packageId": {"type": "string", "minLength": 1},
    "unitId": {"type": "string", "minLength": 1},
    "baselineHash": {"type": "string", "pattern": "^(?:sha256:[a-f0-9]{64}|[a-f0-9]{40}(?:[a-f0-9]{24})?)$"},
    "codeFingerprint": {"type": "string", "minLength": 1},
    "diffFingerprint": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "completedAt": {"type": "string", "format": "date-time"},
    "commands": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false, "required": ["command", "exitCode", "outputFile", "outputHash"], "properties": {"command": {"type": "string", "minLength": 1}, "exitCode": {"const": 0}, "outputFile": {"type": "string", "minLength": 1}, "outputHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}}
    },
    "files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "fileHashes": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}},
    "verdict": {"enum": ["PASS", "FAIL"]}
  }
}
