{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "threejs-global-visual-baseline-selection.schema.json",
  "title": "全局视觉基线三候选人工选择证据（生产者冻结根）",
  "description": "该文件由生产者 Work Item 创建并在冻结后保持不可变；消费者 Work Item 通过 globalVisualBaselineSelectionRef 的 path+sha256 复用，不得改写根证据所有者。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "workItemId", "selectionId", "brief", "generationBatchId",
    "conditionsFingerprint", "candidates", "humanSelection", "baseline", "frozenAt"
  ],
  "properties": {
    "schemaVersion": {"const": "threejs-global-visual-baseline-selection/1.0"},
    "workItemId": {"type": "string", "minLength": 1, "description": "生成并冻结这份选择根证据的生产者 Work Item 身份；不是消费者 Work Item。"},
    "selectionId": {"type": "string", "minLength": 1},
    "brief": {"$ref": "#/$defs/brief"},
    "generationBatchId": {"type": "string", "minLength": 1},
    "conditionsFingerprint": {"$ref": "#/$defs/sha256"},
    "candidates": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/candidate"}
    },
    "humanSelection": {"$ref": "#/$defs/humanSelection"},
    "baseline": {"$ref": "#/$defs/baseline"},
    "frozenAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["briefId", "path", "sha256"],
      "properties": {
        "briefId": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "fileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "imageRef": {
      "description": "全局候选及冻结锚点只允许 PNG/JPEG；机器文件门还必须检查文件真实魔数。",
      "allOf": [
        {"$ref": "#/$defs/fileRef"},
        {"properties": {"path": {"pattern": "\\.(?:[Pp][Nn][Gg]|[Jj][Pp][Ee]?[Gg])$"}}}
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateId", "origin", "status", "image", "generationRecord"],
      "properties": {
        "candidateId": {"type": "string", "minLength": 1},
        "origin": {"const": "generated"},
        "status": {"const": "GENERATED"},
        "image": {"$ref": "#/$defs/imageRef"},
        "generationRecord": {"$ref": "#/$defs/fileRef"}
      }
    },
    "humanSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewMode", "status", "selectedCandidateId", "presentedCandidateIds",
        "decisionFile", "decisionSha256", "confirmedAt", "userOriginalText"
      ],
      "properties": {
        "reviewMode": {"const": "SINGLE_HUMAN"},
        "status": {"const": "CONFIRMED"},
        "selectedCandidateId": {"type": "string", "minLength": 1},
        "presentedCandidateIds": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "decisionFile": {"type": "string", "minLength": 1},
        "decisionSha256": {"$ref": "#/$defs/sha256"},
        "confirmedAt": {"type": "string", "format": "date-time"},
        "userOriginalText": {"type": "string", "minLength": 1}
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "version", "status", "document", "documentSha256", "styleFingerprint",
        "primaryAnchor", "selectedCandidateId", "selectedCandidate"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "status": {"const": "global-static-baseline-frozen"},
        "document": {"const": "docs/visual-baseline.md"},
        "documentSha256": {"$ref": "#/$defs/sha256"},
        "styleFingerprint": {"$ref": "#/$defs/sha256"},
        "primaryAnchor": {"$ref": "#/$defs/imageRef"},
        "selectedCandidateId": {"type": "string", "minLength": 1},
        "selectedCandidate": {"$ref": "#/$defs/imageRef"}
      }
    }
  }
}
