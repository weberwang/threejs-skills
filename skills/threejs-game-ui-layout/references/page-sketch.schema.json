{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "threejs-page-sketch.schema.json",
  "title": "V4 页面还原草图",
  "type": "object",
  "required": ["schema", "target_sha256", "scene_id", "state_id", "work_item_id", "candidate_version", "viewport", "reference_file", "v2_nodes_file", "v2_nodes_sha256", "v3_manifest_file", "v3_manifest_sha256", "v3_evidence_file", "v3_evidence_sha256", "v3_assets", "nodes", "node_presentations", "layout", "confirmation"],
  "properties": {
    "schema": {"const": "threejs-page-sketch/1.0"},
    "target_sha256": {"$ref": "#/$defs/sha256"},
    "scene_id": {"type": "string", "minLength": 1}, "state_id": {"type": "string", "minLength": 1},
    "work_item_id": {"type": "string", "minLength": 1}, "candidate_version": {"type": "string", "minLength": 1},
    "viewport": {"type": "object", "required": ["width", "height"], "properties": {"width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}}},
    "reference_file": {"type": "string", "minLength": 1},
    "v2_nodes_file": {"type": "string", "minLength": 1}, "v2_nodes_sha256": {"$ref": "#/$defs/sha256"},
    "v3_manifest_file": {"type": "string", "minLength": 1}, "v3_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "v3_evidence_file": {"type": "string", "minLength": 1}, "v3_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "v3_assets": {"type": "array", "items": {"type": "object", "required": ["asset_id", "file", "sha256", "layout_node_id"], "properties": {"asset_id": {"type": "string", "minLength": 1}, "file": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "layout_node_id": {"type": "string", "minLength": 1}}}},
    "nodes": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["layout_node_id", "parent_layout_node_id", "target_bounds"]}},
    "node_presentations": {"type": "object", "additionalProperties": {"type": "object", "required": ["kind"], "properties": {"kind": {"enum": ["image", "text", "container", "runtime-program"]}}}},
    "layout": {"type": "object", "required": ["schema", "target_sha256", "scene_id", "state_id", "offsets"], "properties": {"schema": {"const": "threejs-visual-layout/1.0"}, "offsets": {"type": "object", "additionalProperties": {"type": "object", "required": ["x", "y"], "properties": {"x": {"type": "number"}, "y": {"type": "number"}}}}}},
    "confirmation": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["status", "confirmed_at", "content_sha256"], "properties": {"status": {"const": "accepted"}, "confirmed_at": {"type": "string", "format": "date-time"}, "content_sha256": {"$ref": "#/$defs/sha256"}}}]}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}},
  "description": "结构声明之外，路径、节点与资源关联、真实文件 SHA 及确认内容摘要由 page-sketch-contract 和 page-sketch-prerequisite 校验。"
}
